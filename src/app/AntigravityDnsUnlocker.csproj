<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>AntigravityDnsUnlocker</AssemblyName>
    <Version>1.0.0</Version>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- WinForms trimming requires reflection-based JSON, COM interop and the app assembly to be preserved.
         Validate the published binary with the UI surface checks. ReadyToRun reduces startup JIT work. -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <PublishReadyToRun>true</PublishReadyToRun>
    <_SuppressWinFormsTrimError>true</_SuppressWinFormsTrimError>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('app.ico')">app.ico</ApplicationIcon>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin\**;obj\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <!-- The engine scripts and the provider catalog live inside the exe; ScriptStore stages them with an ACL and SHA-256 check. -->
    <EmbeddedResource Include="Engine.ps1" LogicalName="Engine.ps1" />
    <EmbeddedResource Include="Integration.ps1" LogicalName="Integration.ps1" />
    <EmbeddedResource Include="EmergencyRestore.ps1" LogicalName="EmergencyRestore.ps1" />
    <EmbeddedResource Include="profiles.json" LogicalName="profiles.json" />
  </ItemGroup>
  <ItemGroup>
    <TrimmerRootAssembly Include="AntigravityDnsUnlocker" />
  </ItemGroup>
</Project>
